# Copy to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4242
SITE_URL=https://lignaggio.it
# Optional: absolute path to the SQLite file on a persistent disk (Render etc.)
# DB_PATH=/var/data/quiz.db

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key stays server-side only. Never expose it to the frontend or to any
# third party, and never send it to the Keitaro postback.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs, one per price point offered on the offer page
PRICE_159_ID=price_xxx
PRICE_359_ID=price_xxx
PRICE_759_ID=price_xxx
PRICE_1767_ID=price_xxx
PRICE_5_ID=price_xxx
PRICE_9_ID=price_xxx
PRICE_13_ID=price_xxx
SUBSCRIPTION_PRICE_ID=price_xxx

# Start a trial subscription automatically after a one-time purchase.
# On by default; set to "false" to stop it instantly without a deploy.
AUTO_SUBSCRIPTION_ENABLED=true

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx

# ── Keitaro (ad attribution) ─────────────────────────────────────────────────
# Server-side sale postback, sent only after Stripe confirms a payment.
# Leave empty to disable Keitaro tracking entirely — payments are unaffected.
KEITARO_POSTBACK_URL=https://luviva.shop/77a36df/postback

# ── SMTP (transactional email) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=xxx

# ── Google Analytics 4 (read-only reporting in the admin panel) ──────────────
# Numeric GA4 property id — Admin → Property settings → "ID proprietà".
# It is NOT the measurement id G-TMR27C72C3; that one is rejected by the API.
GA_PROPERTY_ID=123456789
# Full service-account JSON key on a single line (raw JSON or base64 of it).
# The service account needs the "Viewer" role on the GA4 property.
# Leave empty to disable GA reporting — nothing else in the app is affected.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"xxx@xxx.iam.gserviceaccount.com"}

# ── Admin panel ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=xxx
ADMIN_SECRET=xxx
