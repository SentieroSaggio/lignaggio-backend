# Copy to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4242
SITE_URL=https://lignaggio.it
# Optional: absolute path to the SQLite file on a persistent disk (Render etc.)
# DB_PATH=/var/data/quiz.db

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key stays server-side only. Never expose it to the frontend or to any
# third party, and never send it to the Keitaro postback.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs, one per price point offered on the offer page
PRICE_159_ID=price_xxx
PRICE_359_ID=price_xxx
PRICE_759_ID=price_xxx
PRICE_1767_ID=price_xxx
PRICE_5_ID=price_xxx
PRICE_9_ID=price_xxx
PRICE_13_ID=price_xxx
SUBSCRIPTION_PRICE_ID=price_xxx

# Start a trial subscription automatically after a one-time purchase.
# Off unless set to exactly "true". When on, the bank runs a card check that the
# customer sees as a second charge request right after paying — many decline it.
# Leaving this off does not remove subscriptions: /create-subscription still works.
AUTO_SUBSCRIPTION_ENABLED=false

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx

# ── Keitaro (ad attribution) ─────────────────────────────────────────────────
# Server-side sale postback, sent only after Stripe confirms a payment.
# Leave empty to disable Keitaro tracking entirely — payments are unaffected.
KEITARO_POSTBACK_URL=https://luviva.shop/77a36df/postback

# ── SMTP (transactional email) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=xxx

# ── Admin panel ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=xxx
ADMIN_SECRET=xxx
